# --- Скопируй в .env.development и заполни ---

# PostgreSQL. Для теста гипотезы — тот же сервер Postgres, что у Mentala,
# но ОТДЕЛЬНАЯ база данных (например, jobai), не общая с Mentala.
NUXT_DATABASE_URL=postgres://user:password@localhost:5432/jobai

# Redis. Тот же инстанс, что у Mentala, но отдельный logical DB / префикс ключей.
NUXT_REDIS_URL=redis://localhost:6379/1

# OpenAI (LLM для генерации вопросов/разбора + Realtime Voice)
NUXT_OPENAI_API_KEY=

# Секрет для подписи сессий и magic-link (Telegram -> Web)
NUXT_SESSION_SECRET=change-me

# HeadHunter API (публичные вакансии — без авторизации)
NUXT_HH_API_BASE_URL=https://api.hh.ru

# Публичные
NUXT_PUBLIC_APP_NAME=JobAI
NUXT_PUBLIC_API_BASE=/api
