# ====================================================================
# Гласно — пример переменных окружения.
# Скопируй в .env.development и заполни. НЕ коммить .env* (он в .gitignore).
#
# Пометки:
#   [нужно сейчас]    — для текущих фаз (БД, OpenAI, сессии)
#   [скоро]           — понадобится в ближайших фазах (Telegram, TTS, оплата)
#   [позже/опц.]      — опционально, по мере роста
#   (из Mentala)      — можно взять то же значение из mentala/frontend/.env.development
# ====================================================================

# --- Приложение -----------------------------------------------------
NUXT_PUBLIC_APP_NAME=Гласно
NUXT_PUBLIC_API_BASE=/api
NUXT_PUBLIC_APP_URL=http://localhost:3000      # базовый URL сайта (для magic-link)
NUXT_PUBLIC_LANDING_SITE_URL=https://glasno.app # публичная ссылка для «Поделиться»
NUXT_PUBLIC_IS_DEV=true

# --- PostgreSQL  [нужно сейчас] -------------------------------------
# Тот же сервер Postgres, что у Mentala, но ОТДЕЛЬНАЯ база glasno.
NUXT_DATABASE_URL=postgres://mentala_user:ПАРОЛЬ@127.0.0.1:54320/glasno
NUXT_DB_SSL=false

# --- Redis  [скоро: очереди отчётов]  (из Mentala) ------------------
# Тот же инстанс, что у Mentala, но ОТДЕЛЬНЫЙ logical DB (индекс /1) или префикс ключей.
NUXT_REDIS_URL=redis://localhost:6379/1
# Альтернатива (как в Mentala) — по частям:
# REDIS_HOST=
# REDIS_PORT=
# REDIS_PASSWORD=
BULLMQ_ENABLE_WORKERS=true
# Phase 3: если true, постановка отчёта идёт через BullMQ и нужен отдельный worker.
# По умолчанию false: dev/MVP генерирует отчёт синхронно с теми же сервисами.
REPORT_QUEUE_ASYNC=false
# Фоновое автопродление подписок (server/plugins/billingRenewalWorker.ts):
# при NUXT_REDIS_URL — BullMQ-джоб раз в час, без Redis — интервал в процессе.
# Kill-switch на случай инцидента с автосписаниями:
BILLING_RENEWAL_DISABLED=false

# --- OpenAI  [только runtime приложения] ----------------------------
# Отдельный ключ Гласно: пользовательские интервью, разборы и Realtime Voice.
# Не дели ключ с другими проектами и не используй его в служебных генераторах.
NUXT_OPENAI_API_KEY=
# Была gpt-4o-mini (заменено 2026-07 на более дешёвый/сильный преемник)
NUXT_OPENAI_MODEL=gpt-5.4-nano
# Подсказки-термины (learning terms): отдельная, самая дешёвая модель
NUXT_OPENAI_LEARNING_MODEL=gpt-5-nano
NUXT_OPENAI_VISION_EXTRACT_MODEL=gpt-4o-mini

# AI-relay (опц., из Mentala): если OpenAI ходит через прокси-релей Mentala
# (актуально для доступа из РФ). Если используешь — скопируй значения из Mentala.
AI_USE_RELAY=false
# AI_RELAY_URL=
# AI_RELAY_AUTH_SECRET=
# AI_RELAY_CLIENT_ID=

# --- Доп. LLM-провайдеры  [позже/опц.]  (из Mentala) ----------------
# Возможные альтернативы/удешевление. Подключим при необходимости.
# NUXT_DEEPSEEK_API_KEY=
# YANDEX_AI_STUDIO_API_KEY=
# POLZA_AI=

# --- Речь: распознавание (STT) и озвучка (TTS)  [скоро] -------------
# Распознавание на старте — браузерное (Web Speech API), ключи не нужны.
NUXT_PUBLIC_SPEECH_DEFAULT_ENGINE=webspeech     # webspeech | auto; whisper не подключаем
# TTS интервьюера. В фазе 5 используется OpenAI TTS; Yandex env оставлен для будущего fallback.
NUXT_FEATURE_TTS_ENABLED=true
NUXT_OPENAI_TTS_MODEL=gpt-4o-mini-tts
NUXT_OPENAI_TTS_VOICE=alloy
NUXT_OPENAI_REALTIME_MODEL=gpt-realtime-mini
NUXT_OPENAI_REALTIME_VOICE=marin
# YANDEX_SPEECHKIT_VOICE=
# YANDEX_SPEECHKIT_FORMAT=

# --- Telegram-бот / Telegram Login  [нужно для Telegram-входа] -------
# Создай отдельного бота через @BotFather и вставь его токен.
# Токен бота Mentala использовать НЕЛЬЗЯ — это другой продукт.
NUXT_TELEGRAM_BOT_TOKEN=

# --- Telegram-алерты (регистрации/удаления/оплаты/критичные ошибки) --
# Временно те же креды, что и для деплой-алертов в CI (см. .docs/DEPLOY.md,
# технический долг №5) — общий с Mentala бот и чат "Mentala Alerts".
# Пусто — алерты молча не отправляются (не ломает приложение).
NUXT_TELEGRAM_ALERTS_BOT_TOKEN=
NUXT_TELEGRAM_ALERTS_CHAT_ID=
# Прямой api.telegram.org заблокирован с прод-сервера (РФ) — используем
# прокси Mentala (Cloudflare Worker), см. .docs/DEPLOY.md техдолг №5.
NUXT_TELEGRAM_ALERTS_API_HOST=

# --- Оплата: YooKassa  [позже]  (из Mentala — тест-режим) -----------
# Для теста можно тот же магазин в тест-режиме; для прод-приёма денег
# по Гласно лучше отдельный магазин позже.
NUXT_YOOKASSA_SHOP_ID=
NUXT_YOOKASSA_SECRET_KEY=
NUXT_YOOKASSA_TEST_MODE=true
# URL для кабинета YooKassa: https://your-domain.ru/api/billing/webhook/yookassa
# События: payment.succeeded, payment.canceled.
# YOOKASSA_WEBHOOK_URL=https://your-domain.ru/api/billing/webhook/yookassa
# IP-проверка вебхука (allowlist официальных IP YooKassa,
# server/application/billing/yookassaWebhookIps.ts) по умолчанию только
# ЛОГИРУЕТ недоверенные источники, не блокируя: подделка платежа всё равно
# невозможна (статус верифицируется обратным запросом в YooKassa API).
# Жёсткую блокировку включать только после проверки x-forwarded-for
# на прод-инфраструктуре:
NUXT_YOOKASSA_WEBHOOK_ENFORCE_IP=false
# Переопределить список доверенных CIDR:
# NUXT_YOOKASSA_TRUSTED_IPS=185.71.76.0/27,185.71.77.0/27

# --- Безопасность / сессии  [нужно сейчас] -------------------------
# Секреты для Гласно генерируй НОВЫЕ (не переноси из Mentala).
# Сгенерировать: openssl rand -hex 32
NUXT_SESSION_SECRET=
AUTH_EMAIL_CODE_SECRET=                         # HMAC email-кодов
EMAIL_HASH_PEPPER=                              # HMAC email lookup без raw email
SUMMARY_AES_KEY=                                # если шифруем транскрипты/разборы (32 байта)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# --- Роли  [нужно сейчас] ------------------------------------------
# Allowlist админов (роль admin = без лимитов на AI). Через запятую.
# Роль выдаётся автоматически при входе по email/telegram_id из списка.
ADMIN_EMAILS=
ADMIN_TELEGRAM_IDS=

# Тестовый вход для внешних проверяющих: e-mail из списка входят по фиксированному
# шестизначному коду без отправки письма. Не добавляй сюда личные/боевые аккаунты.
AUTH_TEST_LOGIN_EMAILS=
AUTH_TEST_LOGIN_CODE=

# --- HeadHunter API  [скоро] ---------------------------------------
NUXT_HH_API_BASE_URL=https://api.hh.ru
# Создать приложение и получить credentials: https://dev.hh.ru/admin
# Можно задать уже сгенерированный токен приложения:
NUXT_HH_ACCESS_TOKEN=
# Или client credentials для автоматического получения app token через /token:
NUXT_HH_CLIENT_ID=
NUXT_HH_CLIENT_SECRET=

# --- Email / SMTP  [позже/опц.]  (из Mentala) ----------------------
# Нужно только если включим email-вход/уведомления. Telegram-first — можно без этого.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_SECURE=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_FROM_NAME=

# --- Приватные аватары (S3 / Yandex Object Storage) -----------------
# Bucket должен быть private: браузер обращается только к /api/auth/profile/avatar.
# Для Yandex Object Storage: https://storage.yandexcloud.net и ru-central1.
STORAGE_ENDPOINT=
STORAGE_REGION=ru-central1
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
STORAGE_BUCKET=

# --- НЕ переносим из Mentala (нерелевантно Гласно) ------------------
# Apple IAP / Apple SignIn, Android App Link, Firebase (VITE_FIREBASE_*,
# FIREBASE_SERVICE_ACCOUNT_JSON), HeyGen (аватары), нативное аудио,
# медитации/сцены, slots-scheduler уведомлений.
