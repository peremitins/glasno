# ====================================================================
# Гласно — шаблон прод-переменных для /opt/glasno/prod/.env (chmod 600).
# Реальный файл живёт ТОЛЬКО на сервере, в git не коммитится.
# Секреты генерируй новые: openssl rand -hex 32 (не переноси из Mentala).
# ====================================================================

# --- Деплой (APP_IMAGE/MIGRATE_IMAGE перезаписывает CI при каждом деплое) ---
APP_IMAGE=ghcr.io/peremitins/glasno:prod-latest
MIGRATE_IMAGE=ghcr.io/peremitins/glasno:prod-migrate
# recreate — простой перезапуск (5–10 c даунтайма); bluegreen — без даунтайма,
# но требует запаса RAM (на сервере её мало — начинаем с recreate).
DEPLOY_STRATEGY=recreate

# --- Приложение -----------------------------------------------------
NODE_ENV=production
NUXT_PUBLIC_APP_NAME=Гласно
NUXT_PUBLIC_API_BASE=/api
NUXT_PUBLIC_APP_URL=https://my.glasno.app
NUXT_PUBLIC_IS_DEV=false
# CORS: origin-ы лендинга, которым разрешены запросы к API приложения.
ALLOWED_ORIGINS=https://glasno.app,https://www.glasno.app

# --- PostgreSQL (контейнер glasno-postgres-prod, адрес по docker-сети!) ---
# Пароль в NUXT_DATABASE_URL продублируй литерально: интерполяция ${VAR}
# внутри env_file не гарантируется docker compose.
POSTGRES_PASSWORD=
NUXT_DATABASE_URL=postgresql://glasno_user:ПАРОЛЬ@postgres:5432/glasno
NUXT_DB_SSL=disable

# --- Redis (контейнер glasno-redis-prod, адрес по docker-сети!) -----
# Пароль в NUXT_REDIS_URL тоже литерально.
REDIS_PASSWORD=
NUXT_REDIS_URL=redis://:ПАРОЛЬ@redis:6379/0
BULLMQ_ENABLE_WORKERS=true
REPORT_QUEUE_ASYNC=false
# Фоновое автопродление подписок включено по умолчанию.
# Kill-switch на случай инцидента с автосписаниями:
BILLING_RENEWAL_DISABLED=false

# --- OpenAI (LLM + Realtime Voice) ----------------------------------
NUXT_OPENAI_API_KEY=
NUXT_OPENAI_MODEL=gpt-5.4-nano
NUXT_OPENAI_VISION_EXTRACT_MODEL=gpt-4o-mini
NUXT_OPENAI_TTS_MODEL=gpt-4o-mini-tts
NUXT_OPENAI_TTS_VOICE=alloy
NUXT_OPENAI_REALTIME_MODEL=gpt-realtime
NUXT_OPENAI_REALTIME_VOICE=marin
# Сервер в РФ (Yandex Cloud): прямой доступ к api.openai.com скорее всего
# закрыт — включаем relay. ВАЖНО: realtime использует WebSocket, поддержку
# relay проверить первым смоук-тестом (риск №1 в .docs/DEPLOY.md).
AI_USE_RELAY=true
AI_RELAY_URL=
AI_RELAY_AUTH_SECRET=
AI_RELAY_CLIENT_ID=glasno-prod

# --- Речь ------------------------------------------------------------
NUXT_PUBLIC_SPEECH_DEFAULT_ENGINE=webspeech
NUXT_FEATURE_TTS_ENABLED=true

# --- Telegram-бот (отдельный бот Гласно, НЕ бот Mentala) -------------
NUXT_TELEGRAM_BOT_TOKEN=

# --- Оплата: YooKassa ------------------------------------------------
# Webhook в кабинете: https://my.glasno.app/api/billing/webhook/yookassa
NUXT_YOOKASSA_SHOP_ID=
NUXT_YOOKASSA_SECRET_KEY=
NUXT_YOOKASSA_TEST_MODE=true
NUXT_YOOKASSA_WEBHOOK_ENFORCE_IP=false

# --- Email / SMTP (опционально) --------------------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Гласно

# --- HeadHunter API ---------------------------------------------------
NUXT_HH_API_BASE_URL=https://api.hh.ru
NUXT_HH_ACCESS_TOKEN=
NUXT_HH_CLIENT_ID=
NUXT_HH_CLIENT_SECRET=

# --- Безопасность / сессии (все — openssl rand -hex 32) ---------------
NUXT_SESSION_SECRET=
AUTH_EMAIL_CODE_SECRET=
EMAIL_HASH_PEPPER=
SUMMARY_AES_KEY=
RATE_LIMIT_MAX=180
RATE_LIMIT_WINDOW_MS=60000

# --- Роли --------------------------------------------------------------
ADMIN_EMAILS=peremitinns@gmail.com
ADMIN_TELEGRAM_IDS=

# --- Telegram-алерты деплоя (опционально, для CI) ----------------------
NUXT_TELEGRAM_ALERTS_BOT_TOKEN=
NUXT_TELEGRAM_ALERTS_CHAT_ID=

# Перевыпуск деплоя: 2026-07-04 (обновлён PROD_SSH_KEY на отдельный деплой-ключ glasno_deploy)
